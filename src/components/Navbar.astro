---
import {Icon} from 'astro-icon/components';
import LanguagePicker from "./LanguagePicker.astro";
import {getRelativeLocaleUrl} from "astro:i18n";
const i18n = true;

//

const localisations = {
    "cs": {
        "Home": "Domů",
        "Projects": "Projekty",
        "MHD game": "MHD hra",
    },
    "en": {
        "Home": "Home",
        "Projects": "Projects",
        "MHD game": "MHD game"
    }
};

let currentLocale = "en";
if (Astro.currentLocale) {
    currentLocale = Astro.currentLocale;
}

let pages = [
    {name: localisations[currentLocale]["Home"], url: getRelativeLocaleUrl(currentLocale, "/"), icon: "mdi:home"},
    {name: localisations[currentLocale]["Projects"], url: getRelativeLocaleUrl(currentLocale, "/projects"), icon: "mdi:construction"},
];

pages = pages.filter(page => page.url !== Astro.url.pathname);
console.log(Astro.url.pathname)

interface Props {
    i18n?: boolean;
}

const props = Astro.props as Props;
---

<>
    <div id="big-screen-nav">
        <nav>
            <ul>
                {pages.map((page) => (
                        <li>
                            <a href={page.url}>
                                <Icon name={page.icon} style="margin-right: 5px;"/>
                                {page.name}
                                <span class="show-on-hover"><Icon name="mdi:arrow-right"/></span>
                            </a>
                        </li>
                ))
                }
            </ul>
        </nav>
    </div>
    <div id="navigation" class="hidden">
        <nav>
            <ul>
                {pages.map((page) => (
                        <li>
                            <a href={page.url}>
                                {page.name}
                                <span class="show-on-hover"><Icon name="mdi:arrow-right"/></span>
                            </a>
                        </li>
                ))
                }
            </ul>
        </nav>
        <div class="bottom">
            <div class="special-picker">
                {props.i18n &&
                        <LanguagePicker/>}
            </div>
        </div>
        <div class="real-bottom">

        </div>
    </div>
</>
<style>
    a {
        text-decoration: none !important;
        color: inherit;
        display: flex;
        align-items: center;
        width: 100%;
    }

    a:hover {
        text-decoration: none;
    }

    #navigation {
        position: fixed;
        top: 60px;
        right: 0;
        height: calc(100% - 60px);
        background-color: var(--silver);
        z-index: 1000;
        max-width: 40vw;
        min-width: 200px;
        animation: slideIn 0.5s ease-in-out forwards;
    }

    #big-screen-nav {
        display: flex;
        margin: 0;
        padding: 0;
        ul {
            display: flex;
            flex-direction: row;
            list-style: none;
            gap: 1em;
            padding: 0;
            margin: 0;
        }
        a {
            width: auto;
        }
        nav {
            padding: 0;
        }
    }

    @keyframes slideIn {
        from {
            transform: translateX(100%);
        }

        to {
            transform: translateX(0);
        }
    }

    #navigation nav {
        padding: 10px;
    }

    #navigation ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    #navigation li {
        margin: 0;
        padding: 10px 0;
        border-bottom: 1px solid;
        display: flex;
        align-items: center;
        transition: padding-left 0.2s ease-in-out;
    }

    #navigation li:hover {
        padding-left: 3px;
    }

    #navigation li:hover {
        margin-left: 5px;
        color: var(--rose-taupe);
    }

    .show-on-hover {
        display: none;
    }

    #navigation li:hover .show-on-hover {
        display: inline;
        margin-left: 5px;
    }

    #navigation.hidden {
        display: block;
        transform: translateX(100%);
        animation: slideOut 0s ease-in-out forwards;
    }

    @keyframes slideOut {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(100%);
        }
    }

    @media screen and (max-width: 450px) {
        #navigation {
            max-width: 100vw;
            min-width: 100vw;
        }
    }

    @media screen and (max-width: 780px) {
        #big-screen-nav {
            display: none;
        }
    }

    @media screen and (min-width: 780px) {
        #navigation:not(.hidden) {
            display: block;
            transform: translateX(100%);
            animation: slideOut 0s ease-in-out forwards;
        }
    }
</style>

<style is:global>
    .dark #navigation {
        background-color: var(--gray-dark) !important;
    }

    .dark #navigation li:hover {
        color: var(--pale-dogwood) !important;
    }

    .special-picker .language-picker {
        display: none;
        margin: 10px;
    }

    @media screen and (max-width: 500px) {
        .special-picker .language-picker {
            display: block;
        }
    }

    .bottom {
        width: fit-content;
        margin: 0 auto;
    }
</style>