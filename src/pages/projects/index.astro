---
// get content from the astro collection "projects"
import Layout from "../../layouts/Layout.astro";
import {getCollection} from "astro:content";
import Project from "../../components/Project.astro";
import {Icon} from "astro-icon/components";
import ViewMoreOnGithub from "../../components/ViewMoreOnGithub.astro";

let projects = await getCollection("projects");
projects = projects.sort((a, b) => {
    if (a.data.featured && !b.data.featured) {
        return -1;
    } else if (!a.data.featured && b.data.featured) {
        return 1;
    } else {
        return 0;
    }
});
---

<Layout title="Projects"
        description="A selection of projects I've created that might interest you"
        metaDesc="A selection of projects I've created that might interest you"
        metaTags={["Jan Štefanča", "PanJohnny", "projects"]}
        i18n
>
    <section id="projects">
        <ul class="projects">
            {projects.map((project) => (
                    <Project name={project.data.title} desc={project.data.description} page={"/project/" + project.id} featured={project.data.featured}/>
            ))}
        </ul>
        <ViewMoreOnGithub />
    </section>
</Layout>
